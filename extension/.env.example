# Local development only: copy this to .env.development (npm run dev reads it).
# Production builds (npm run build) ignore it and always talk to https://purl.live;
# they fail if VITE_PURL_URL is set to anything else in .env or .env.production.
# `npm run dev` also gives the extension a permission for this address.
VITE_PURL_URL=http://localhost:3000
